{
  "name": "jules-mobile-client",
  "version": "1.0.0",
  "private": true,
  "author": "involvex",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "build:android": "eas build --platform android --local",
    "format": "prettier --write .",
    "generate-licenses": "bun scripts/generate-licenses.ts",
    "ios": "expo start --ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "oxc": "oxlint --type-aware",
    "oxc:fix": "oxlint --type-aware --fix",
    "prebuild": "bun run format && bun run lint:fix && bun run oxc:fix && bun run typecheck",
    "reset-project": "node ./scripts/reset-project.js",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@octokit/rest": "^22.0.1",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/elements": "^2.9.3",
    "@react-navigation/native": "^7.1.26",
    "@types/react-syntax-highlighter": "^15.5.13",
    "date-fns": "^4.1.0",
    "expo": "^54.0.31",
    "expo-constants": "^18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-device": "^8.0.10",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-notifications": "^0.32.16",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "lodash": "^4.17.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.83.1",
    "react-native-a": "^1.0.1",
    "react-native-fit-image": "^1.5.5",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.19.0",
    "react-native-syntax-highlighter": "^2.1.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.7.1",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.8",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "oxlint": "^1.38.0",
    "oxlint-tsgolint": "^0.11.0",
    "prettier": "^3.7.4",
    "prettier-plugin-import-sort": "^0.0.7",
    "prettier-plugin-multiline-arrays": "^4.1.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^2.5.20",
    "prettier-plugin-sort-imports": "^1.8.9",
    "typescript": "~5.9.3"
  },
  "packageManager": "bun@1.3.5",
  "engineStrict": true,
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.5"
    }
  },
  "importSort": {
    ".js, .jsx, .ts, .tsx": {
      "style": "module"
    }
  }
}
